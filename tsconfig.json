{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "strict": true, "skipLibCheck": true, "esModuleInterop": true,
    "allowImportingTsExtensions": true, "noEmit": true, "types": ["node"]
  },
  "include": ["src", "server", "scripts", "tests", "*.ts"]
}
