@namespace GraspPortable.App.Records
@using Microsoft.AspNetCore.Components
@using Microsoft.JSInterop
@using GraspPortable.App.Backend
@using GraspPortable.Contracts
@implements IAsyncDisposable
@inject BackendSession Backend

<div @ref="_element" class="records-markdown @(Compact ? "compact" : "")" aria-label="Markdown 閱讀內容" data-records-render-expected="@_generation" data-records-paint-expected="@(_measureRecords ? _generation.ToString(System.Globalization.CultureInfo.InvariantCulture) : null)"></div>
@if (_message is not null) { <p class="markdown-message" role="status">@_message</p> }

@code {
    [Parameter, EditorRequired] public RecordsModuleOwner ModuleOwner { get; set; } = default!;
    [Parameter] public string Markdown { get; set; } = "";
    [Parameter] public ReferenceDto[]? References { get; set; }
    [Parameter] public RegionDto[]? Regions { get; set; }
    [Parameter] public bool Compact { get; set; }
    [Parameter] public string OriginNoteId { get; set; } = "";
    [Parameter] public string WorkspaceKey { get; set; } = "";
    [Parameter] public long Revision { get; set; }
    [Parameter] public EventCallback<RecordsContentNavigation> OnNavigate { get; set; }
    private ElementReference _element;
    private IJSObjectReference? _module;
    private Task<IJSObjectReference>? _moduleLoad;
    private RecordsModuleOwner.Lease? _moduleLease;
    private DotNetObjectReference<RecordsMarkdown>? _receiver;
    private (string, string, string, long, string)? _requested;
    private bool _needsRender;
    private readonly bool _measureRecords = Environment.GetEnvironmentVariable("GRASP_MEASURE_UI") == "1";
    private long _generation;
    private bool _disposed;
    private string? _message;
    protected override void OnInitialized() => _moduleLease = ModuleOwner.Acquire();
    protected override void OnParametersSet()
    {
        if (_disposed) return;
        var semantics = System.Text.Json.JsonSerializer.Serialize(new { References, Regions });
        var snapshot = (Markdown, OriginNoteId, WorkspaceKey, Revision, semantics);
        if (_requested == snapshot) return;
        _requested = snapshot; _needsRender = true; _generation++; _message = null;
    }
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_disposed || !_needsRender) return;
        var generation = _generation; _needsRender = false;
        _moduleLoad ??= _moduleLease!.GetAsync();
        _module ??= await _moduleLoad;
        if (_disposed || generation != _generation) return;
        _receiver ??= DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("renderMarkdown", _element, Markdown, OriginNoteId, _receiver, generation, References ?? [], Regions ?? []);
    }
    private bool IsOriginAllowed(string origin) => origin == OriginNoteId || References?.Any(reference => reference.OriginNoteId == origin) == true;
    [JSInvokable]
    public async Task<string?> ResolveImage(string origin, string target, bool wiki, long generation)
    {
        if (_disposed || generation != _generation || !IsOriginAllowed(origin)) return null;
        var workspace = WorkspaceKey;
        try
        {
            var image = await Backend.SendAsync<ContentImageDto>(System.Net.Http.HttpMethod.Post, "api/content/image", new ContentResolveRequest(origin, target, wiki));
            return !_disposed && generation == _generation && workspace == WorkspaceKey && image.Status == "resolved" ? image.DataUrl : null;
        }
        catch (Exception error) when (error is System.Net.Http.HttpRequestException or InvalidOperationException or OperationCanceledException) { return null; }
    }
    [JSInvokable]
    public async Task Navigate(string origin, string target, bool wiki, long generation)
    {
        if (_disposed || generation != _generation || !IsOriginAllowed(origin)) return;
        var workspace = WorkspaceKey;
        try
        {
            if (Uri.TryCreate(target, UriKind.Absolute, out var external) && external.Scheme is "http" or "https")
            { await OnNavigate.InvokeAsync(new(Url: target)); return; }
            var result = await Backend.SendAsync<ContentLinkDto>(System.Net.Http.HttpMethod.Post, "api/content/link", new ContentResolveRequest(origin, target, wiki));
            if (_disposed || generation != _generation || workspace != WorkspaceKey) return;
            if (result.Status == "resolved")
                await OnNavigate.InvokeAsync(new(result.NoteId, result.RelativePath, result.Anchor));
            else { _message = result.Message ?? "無法唯一定位這個連結。"; await InvokeAsync(StateHasChanged); }
        }
        catch (Exception error) when (error is System.Net.Http.HttpRequestException or InvalidOperationException or OperationCanceledException)
        { if (!_disposed && generation == _generation) { _message = error.Message; await InvokeAsync(StateHasChanged); } }
    }
    [JSInvokable]
    public Task NavigateRecord(string recordId, long generation)
    {
        if (_disposed || generation != _generation || !Guid.TryParseExact(recordId, "N", out var id) || id == Guid.Empty) return Task.CompletedTask;
        return OnNavigate.InvokeAsync(new(RecordId: recordId));
    }
    [JSInvokable]
    public Task NavigateDefinition(string name, long generation)
    {
        if (_disposed || generation != _generation || References?.Any(reference => reference.Name == name) != true) return Task.CompletedTask;
        return OnNavigate.InvokeAsync(new(DefinitionName: name));
    }
    public async ValueTask DisposeAsync()
    {
        _disposed = true; _generation++;
        try
        {
            // Await this cell's in-flight import before releasing its lease. The shared
            // module remains alive until every child has cleaned its own element.
            if (_moduleLoad is not null)
            {
                var module = await _moduleLoad;
                await module.InvokeVoidAsync("disposeMarkdown", _element);
            }
        }
        catch (JSException) { }
        finally
        {
            try { if (_moduleLease is not null) await _moduleLease.DisposeAsync(); }
            finally { _receiver?.Dispose(); }
        }
    }
}
